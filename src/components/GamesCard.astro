---
const { game } = Astro.props;
---

<div class="rounded-2xl bg-gray-400 p-3">
    <div>
        <div>
            <span class="font-bold"> {game.name}</span>
        </div>
        <div>
            <span class="font-light">({game.manufacturer}, {game.year})</span>
        </div>
    </div>
</div>
