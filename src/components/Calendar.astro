---
import { getCollection } from "astro:content";
import { normalizeCalendar } from "../utils/normalizeCalendar";

import CalendarCard from "./CalendarCard.astro";
import CalendarModal from "./CalendarModal.astro";

const calendar = await getCollection("calendarItems");
const entries = normalizeCalendar(calendar);
---

<section>
    <div class="calendar-list flex h-screen flex-col gap-5">
        {entries.map((entry: object) => <CalendarCard details={entry} />)}
    </div>
    <CalendarModal events={entries} />
</section>
