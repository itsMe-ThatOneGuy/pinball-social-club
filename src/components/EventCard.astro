---
import { Image } from "astro:assets";

const { event, index, description } = Astro.props;
---

<article
    class="grid grid-cols-1 items-center gap-6 py-8 md:grid-cols-2 md:gap-10 md:py-12"
>
    {
        event.thumbnail && (
            <div class="aspect-4/3 overflow-hidden">
                <Image
                    src={event.thumbnail}
                    alt="test"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
            </div>
        )
    }

    <div
        class:list={[
            "flex flex-col gap-3",
            !event.thumbnail && "md:col-span-2",
        ]}
    >
        <h3 class="text-2xl font-bold">{event.title}</h3>
        <p class="text-sm tracking-[0.2em] text-amber-400 uppercase">
            {event.frequency}
        </p>
        <div class="event-body leading-relaxed" set:html={description} />
    </div>
</article>
