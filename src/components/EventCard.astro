---
const { start, image, title } = Astro.props;
---

<!--GRID ITEM-->
<div
    class="flex h-89 w-xs flex-col overflow-hidden rounded-xl border border-black"
>
    <!--EVENT CARD-->
    <!--DATE-->
    <div
        class="absolute z-10 w-20 rounded-tl-xl rounded-br-xl bg-gray-700 text-center"
    >
        <p>{start.month} <br />{start.day}<br />{start.weekday}</p>
    </div>
    <!--IMAGE-->
    <div class="z-2">
        <img src={image} />
    </div>
    <!--INFO-->
    <div class="p-8">
        <div>{title}</div>
        <div
            class="mt-4 flex w-fit rounded-xl bg-[rgb(17,17,17,0.06)] pr-4 pl-1.5"
        >
            <div>C</div>
            <div>4:00 PM - 8:00 PM</div>
        </div>
    </div>
</div>
